# ===== Desenvolvimento local (copie para .env) =====
DATABASE_URL=postgres://clearbalance:clearbalance_local@127.0.0.1:5433/clearbalance
API_PORT=3001
# Só para uso local: dispensa o login. O servidor RECUSA subir em produção com isto ligado.
AUTH_DISABLED=true

# ===== Produção (Vercel + Supabase) =====
# NUNCA coloque valores reais aqui nem em nenhum arquivo do repositório.
# Configure estas variáveis no painel do Vercel (Settings → Environment Variables).
#
# Banco (pooler de transação, porta 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Só no seu computador, para rodar migrações (pooler de sessão, porta 5432):
# MIGRATE_DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# DATABASE_SSL_CA=
#
# Login:
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=          # só se o projeto ainda usa a chave HS256 antiga
# ALLOWED_EMAILS=voce@exemplo.com
# REQUIRE_MFA=false             # true só depois de ativar o 2FA
#
# Front-end (públicas por natureza, mas configure no Vercel):
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
